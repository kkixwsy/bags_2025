<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>
<body>

<nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container-fluid">
    <!-- Заголовок слева -->
    <a class="navbar-brand" href="/">Сумки</a>

    <!-- Кнопка с тремя полосками (гамбургер) для мобильных -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Меню, которое сворачивается на мобильных -->
    <div class="collapse navbar-collapse" id="navbarNav">
      <!-- Динамическое меню сумок слева -->
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <% if (nav && nav.length > 0) { %>
          <% nav.forEach(item => { %>
            <li class="nav-item">
              <a class="nav-link" href="/bags/<%= item.nick %>"><%= item.title %></a>
            </li>
          <% }) %>
        <% } %>
      </ul>

      <ul class="nav navbar-nav navbar-right">
    <%if(user){%>
     <form action="/logout" method="post">
         <li class="nav-item">
          <button type="submit" class="nav-link">Выйти</button>
          </li>
      </form>
   <% } else { %>    
       <li class="nav-item">
          <a class="nav-link" href="/logreg">Войти</a>
       </li>
   <% } %>
</ul>
    </div>
  </div>
</nav>

<!-- Основное содержимое страницы -->
<div class="container mt-4">
  <%- body %>
</div>

<!-- Bootstrap JS для работы гамбургер-меню -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

</body>
</html>